// Prisma schema for Quiniela Mundial 2026
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  name                String
  password            String
  isAdmin             Boolean             @default(false)
  hasPaid             Boolean             @default(false)
  createdAt           DateTime            @default(now())
  predictions         Prediction[]
  specialPredictions  SpecialPrediction?
}

model Match {
  id              String       @id @default(cuid())
  matchNumber     Int          @unique
  stage           String       // "group", "round_of_32", "round_of_16", "quarter", "semi", "third_place", "final"
  group           String?      // "A", "B", ... only for group stage
  homeTeam        String
  awayTeam        String
  kickoffAt       DateTime
  homeScore       Int?
  awayScore       Int?
  winnerOnPens    String?      // For knockouts: home team name, away team name, or null
  isFinalized     Boolean      @default(false)
  predictions     Prediction[]
}

model Prediction {
  id              String   @id @default(cuid())
  userId          String
  matchId         String
  homeScore       Int
  awayScore       Int
  winnerOnPens    String?  // For knockouts when user predicts a draw
  pointsAwarded   Int?     // Calculated after match is finalized
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match           Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
}

model SpecialPrediction {
  id              String   @id @default(cuid())
  userId          String   @unique
  champion        String?
  runnerUp        String?
  thirdPlace      String?
  topScorer       String?
  bestPlayer      String?
  revelationTeam  String?
  pointsAwarded   Int      @default(0)
  lockedAt        DateTime? // When the tournament starts, no more edits
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TournamentResult {
  id              String   @id @default("singleton")
  champion        String?
  runnerUp        String?
  thirdPlace      String?
  topScorer       String?
  bestPlayer      String?
  revelationTeam  String?
  updatedAt       DateTime @updatedAt
}
